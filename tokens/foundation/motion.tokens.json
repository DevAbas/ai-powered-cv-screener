{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Easings, durations and the distances motion covers.",
  "motion": {
    "ease-standard": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "ease-decelerate": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        0,
        1
      ]
    },
    "ease-accelerate": {
      "$type": "cubicBezier",
      "$value": [
        0.3,
        0,
        1,
        1
      ]
    },
    "ease-overshoot": {
      "$type": "cubicBezier",
      "$value": [
        0.34,
        1.56,
        0.64,
        1
      ]
    },
    "ease-entrance": {
      "$type": "cubicBezier",
      "$value": [
        0.33,
        1,
        0.68,
        1
      ]
    },
    "duration-short": {
      "$type": "duration",
      "$value": {
        "value": 150,
        "unit": "ms"
      }
    },
    "duration-medium": {
      "$type": "duration",
      "$value": {
        "value": 200,
        "unit": "ms"
      }
    },
    "duration-color-mode-turn": {
      "$type": "duration",
      "$value": {
        "value": 280,
        "unit": "ms"
      }
    },
    "duration-focus-move": {
      "$type": "duration",
      "$value": {
        "value": 500,
        "unit": "ms"
      }
    },
    "duration-entrance": {
      "$type": "duration",
      "$value": {
        "value": 600,
        "unit": "ms"
      }
    },
    "distance-entrance": {
      "$type": "dimension",
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "stagger-entrance": {
      "$type": "duration",
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "stagger-entrance-word": {
      "$type": "duration",
      "$value": {
        "value": 100,
        "unit": "ms"
      }
    },
    "blur-out-of-focus": {
      "$type": "dimension",
      "$value": {
        "value": 5,
        "unit": "px"
      }
    },
    "duration-breath": {
      "$type": "duration",
      "$value": {
        "value": 1.6,
        "unit": "s"
      }
    },
    "duration-shimmer": {
      "$type": "duration",
      "$value": {
        "value": 1.8,
        "unit": "s"
      }
    },
    "duration-blink": {
      "$type": "duration",
      "$value": {
        "value": 1,
        "unit": "s"
      }
    }
  }
}
