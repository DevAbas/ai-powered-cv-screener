{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Corner radii.",
  "rounded": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "xl": {
      "$value": {
        "value": 1.25,
        "unit": "rem"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  }
}
