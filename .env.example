# Answers, profile extraction, seed generation and embeddings
GOOGLE_GENERATIVE_AI_API_KEY=
# Only for a registry slot on the OpenRouter provider; none uses it today
OPENROUTER_API_KEY=
# The models, by the names in the provider's model list. Pin a release, not a
# moving alias such as gemini-flash-lite-latest, so answers do not change
# under a commit.
# Answers the questions; also extracts the profiles and writes the seeds
ANSWER_MODEL=gemini-3.5-flash-lite
# Embeds the CV chunks and the questions (768 dimensions, set in the registry)
EMBEDDING_MODEL=gemini-embedding-001
# Candidate photos, on Cloudflare Workers AI; the step runs only when named
IMAGE_MODEL=@cf/leonardo/phoenix-1.0
# Workers AI: the account id and a token from the "Use REST API" panel of the
# Workers AI page; free within 10,000 neurons a day. Only the photo step needs them.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Vector store for the chunk vectors (npm run index creates the index)
PINECONE_API_KEY=
PINECONE_INDEX=ai-cv-screener
