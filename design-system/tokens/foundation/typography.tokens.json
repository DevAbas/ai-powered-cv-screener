{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The font families and weights the text styles use.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "google-sans": {
        "$value": "Google Sans"
      },
      "google-sans-flex": {
        "$value": "Google Sans Flex"
      }
    },
    "weight": {
      "300": {
        "$value": 300
      },
      "400": {
        "$value": 400
      },
      "500": {
        "$value": 500
      },
      "600": {
        "$value": 600
      },
      "$type": "fontWeight"
    }
  }
}
