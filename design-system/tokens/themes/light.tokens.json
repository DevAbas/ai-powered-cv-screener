{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The light theme: every colour role and shadow.",
  "color": {
    "$type": "color",
    "surface": {
      "$value": "{palette.gray-background}",
      "$description": "The page background."
    },
    "surface-container-lowest": {
      "$value": "{palette.white}",
      "$description": "The fill of a thing that floats on the page: inputs, menus, the composer, file cards, the CV preview and its pages."
    },
    "surface-container-low": {
      "$value": "{palette.gray-2}",
      "$description": "The first of four ascending fills for controls and their states."
    },
    "surface-container": {
      "$value": "{palette.gray-3}",
      "$description": "The second of four ascending fills for controls and their states."
    },
    "surface-container-high": {
      "$value": "{palette.gray-4}",
      "$description": "The third of four ascending fills for controls and their states."
    },
    "surface-container-highest": {
      "$value": "{palette.gray-5}",
      "$description": "The fourth of four ascending fills for controls and their states."
    },
    "outline": {
      "$value": "{palette.gray-2}",
      "$description": "The one edge colour: every edge, divider and scrollbar thumb."
    },
    "outline-variant": {
      "$value": "{palette.gray-8}",
      "$description": "The strongest neutral that is not text: a disabled icon, a placeholder, a handle being dragged."
    },
    "on-surface-variant": {
      "$value": "{palette.gray-11}",
      "$description": "Secondary text: metadata, captions, icons at rest, disabled text."
    },
    "on-surface": {
      "$value": "{palette.gray-12}",
      "$description": "Body text."
    },
    "primary": {
      "$value": "{palette.mint-9}",
      "$description": "Mint, the only chromatic colour: the primary action and the marks of the brand."
    },
    "on-primary": {
      "$value": "{palette.mint-contrast}",
      "$description": "Text and icons on primary."
    },
    "primary-outline": {
      "$value": "{palette.mint-7}",
      "$description": "The focus ring."
    },
    "primary-text": {
      "$value": "{palette.mint-11}",
      "$description": "The accent as text or an icon on a surface."
    },
    "primary-container": {
      "$value": "{palette.mint-4}",
      "$description": "A light mint tint: the fill of the recruiter's question."
    },
    "on-primary-container": {
      "$value": "{palette.mint-12}",
      "$description": "Text on primary-container."
    },
    "inverse-surface": {
      "$value": "{palette.gray-12}",
      "$description": "A surface in the opposite theme: the fill of a tooltip."
    },
    "inverse-on-surface": {
      "$value": "{palette.gray-background}",
      "$description": "Text on inverse-surface."
    },
    "warning": {
      "$value": "{palette.gold}",
      "$description": "A warning state icon."
    },
    "error": {
      "$value": "{palette.red}",
      "$description": "An error state icon."
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0.8549,
          0.651
        ],
        "hex": "#00daa6"
      },
      "$description": "The primary action on hover. Derived: primary with its OKLCH lightness -0.07, hue and chroma kept.",
      "$extensions": {
        "cv-screener": {
          "derived": {
            "kind": "lightness",
            "from": "primary",
            "lightness": -0.07
          }
        }
      }
    },
    "primary-pressed": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0.7569,
          0.5725
        ],
        "hex": "#00c192"
      },
      "$description": "The primary action while pressed. Derived: primary with its OKLCH lightness -0.14, hue and chroma kept.",
      "$extensions": {
        "cv-screener": {
          "derived": {
            "kind": "lightness",
            "from": "primary",
            "lightness": -0.14
          }
        }
      }
    },
    "surface-panel": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9725,
          0.9725,
          0.9725
        ],
        "hex": "#f8f8f8"
      },
      "$description": "A quiet region that groups related rows on the page. Derived: surface-container-low at 60% over surface.",
      "$extensions": {
        "cv-screener": {
          "derived": {
            "kind": "mix",
            "from": "surface-container-low",
            "weight": 0.6,
            "over": "surface"
          }
        }
      }
    },
    "on-surface-subtle": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.5608,
          0.5608,
          0.5608
        ],
        "hex": "#8f8f8f"
      },
      "$description": "A tertiary label, read last. Derived: on-surface-variant at 70% over surface.",
      "$extensions": {
        "cv-screener": {
          "derived": {
            "kind": "mix",
            "from": "on-surface-variant",
            "weight": 0.7,
            "over": "surface"
          }
        }
      }
    },
    "on-surface-shimmer": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4549,
          0.4549,
          0.4549
        ],
        "hex": "#747474"
      },
      "$description": "The faded ink at either end of the band that sweeps a working progress line. Derived: on-surface at 62% over surface, the smallest share that meets WCAG 2.1 SC 1.4.3 (4.5:1) on surface in both themes.",
      "$extensions": {
        "cv-screener": {
          "derived": {
            "kind": "mix",
            "from": "on-surface",
            "weight": 0.62,
            "over": "surface"
          }
        }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.1,
          "hex": "#000000"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 0.25,
          "unit": "rem"
        },
        "blur": {
          "value": 1.5,
          "unit": "rem"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "overlay": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.1,
          "hex": "#000000"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 0.5,
          "unit": "rem"
        },
        "blur": {
          "value": 2,
          "unit": "rem"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "soft": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.04,
          "hex": "#000000"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 0.125,
          "unit": "rem"
        },
        "blur": {
          "value": 0.75,
          "unit": "rem"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }
}
