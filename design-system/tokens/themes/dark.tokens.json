{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The dark theme: every colour role and shadow.",
  "color": {
    "$type": "color",
    "surface": {
      "$value": "{palette.gray-dark-background}"
    },
    "surface-container-lowest": {
      "$value": "{palette.gray-dark-2}"
    },
    "surface-container-low": {
      "$value": "{palette.gray-dark-3}"
    },
    "surface-container": {
      "$value": "{palette.gray-dark-3}"
    },
    "surface-container-high": {
      "$value": "{palette.gray-dark-4}"
    },
    "surface-container-highest": {
      "$value": "{palette.gray-dark-5}"
    },
    "outline": {
      "$value": "{palette.gray-dark-3}"
    },
    "outline-variant": {
      "$value": "{palette.gray-dark-8}"
    },
    "on-surface-variant": {
      "$value": "{palette.gray-dark-11}"
    },
    "on-surface": {
      "$value": "{palette.gray-dark-12}"
    },
    "primary": {
      "$value": "{palette.mint-dark-9}"
    },
    "on-primary": {
      "$value": "{palette.mint-dark-contrast}"
    },
    "primary-outline": {
      "$value": "{palette.mint-dark-7}"
    },
    "primary-text": {
      "$value": "{palette.mint-dark-11}"
    },
    "primary-container": {
      "$value": "{palette.mint-dark-4}"
    },
    "on-primary-container": {
      "$value": "{palette.gray-dark-12}"
    },
    "inverse-surface": {
      "$value": "{palette.gray-dark-12}"
    },
    "inverse-on-surface": {
      "$value": "{palette.gray-dark-background}"
    },
    "warning": {
      "$value": "{palette.gold-dark}"
    },
    "error": {
      "$value": "{palette.red-dark}"
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0.898,
          0.6941
        ],
        "hex": "#00e5b1"
      },
      "$description": "Derived: primary with its OKLCH lightness -0.07, hue and chroma kept.",
      "$extensions": {
        "cv-screener": {
          "derived": {
            "kind": "lightness",
            "from": "primary",
            "lightness": -0.07
          }
        }
      }
    },
    "primary-pressed": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0.8,
          0.6118
        ],
        "hex": "#00cc9c"
      },
      "$description": "Derived: primary with its OKLCH lightness -0.14, hue and chroma kept.",
      "$extensions": {
        "cv-screener": {
          "derived": {
            "kind": "lightness",
            "from": "primary",
            "lightness": -0.14
          }
        }
      }
    },
    "surface-panel": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1059,
          0.1059,
          0.1059
        ],
        "hex": "#1b1b1b"
      },
      "$description": "Derived: surface-container-low at 60% over surface.",
      "$extensions": {
        "cv-screener": {
          "derived": {
            "kind": "mix",
            "from": "surface-container-low",
            "weight": 0.6,
            "over": "surface"
          }
        }
      }
    },
    "on-surface-subtle": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.5137,
          0.5137,
          0.5137
        ],
        "hex": "#838383"
      },
      "$description": "Derived: on-surface-variant at 70% over surface.",
      "$extensions": {
        "cv-screener": {
          "derived": {
            "kind": "mix",
            "from": "on-surface-variant",
            "weight": 0.7,
            "over": "surface"
          }
        }
      }
    },
    "on-surface-shimmer": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.6039,
          0.6039,
          0.6039
        ],
        "hex": "#9a9a9a"
      },
      "$description": "Derived: on-surface at 62% over surface, the smallest share that meets WCAG 2.1 SC 1.4.3 (4.5:1) on surface in both themes.",
      "$extensions": {
        "cv-screener": {
          "derived": {
            "kind": "mix",
            "from": "on-surface",
            "weight": 0.62,
            "over": "surface"
          }
        }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.5,
          "hex": "#000000"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 0.25,
          "unit": "rem"
        },
        "blur": {
          "value": 1.5,
          "unit": "rem"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "overlay": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.6,
          "hex": "#000000"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 0.5,
          "unit": "rem"
        },
        "blur": {
          "value": 2,
          "unit": "rem"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "soft": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.35,
          "hex": "#000000"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 0.125,
          "unit": "rem"
        },
        "blur": {
          "value": 0.75,
          "unit": "rem"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }
}
