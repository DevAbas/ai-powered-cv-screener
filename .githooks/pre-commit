#!/bin/sh
# The commit gate for a person in the terminal: the strict lint and the
# typecheck (AGENTS.md, Always). Installed by `npm run prepare`, which sets
# core.hooksPath to this folder; the agent's gate is .claude/hooks/guardCommit.mjs.
set -e
cd "$(git rev-parse --show-toplevel)"
if ! command -v node >/dev/null 2>&1; then
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  # shellcheck disable=SC1091
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null 2>&1 && nvm use --silent >/dev/null 2>&1
fi
npm run -s lint:strict
npm run -s typecheck
