#!/bin/sh
# The commit gate for a person in the terminal: the strict lint, the
# typecheck and the design system's checks (AGENTS.md, Always), as the
# `beforeCommit` commands of design-system/gates.json. Installed by `npm run
# prepare`, which sets core.hooksPath to this folder; an agent's commit runs
# the same stage through .claude/hooks/design-system/guard-commit.mjs.
# with-node.sh loads nvm and the project's .nvmrc when `node` is not on PATH.
set -e
"$(git rev-parse --show-toplevel)"/design-system/harness/with-node.sh design-system/harness/run-gates.mjs before-commit
